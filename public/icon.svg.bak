<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 190 210" fill="none">
  <defs>
    <!-- F letter: deep navy gradient -->
    <linearGradient id="gF" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1448C8"/>
      <stop offset="100%" stop-color="#0A1F6E"/>
    </linearGradient>

    <!-- P letter: bright cobalt/royal blue -->
    <linearGradient id="gP" x1="0%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" stop-color="#4D9FFF"/>
      <stop offset="50%" stop-color="#2979FF"/>
      <stop offset="100%" stop-color="#1448C8"/>
    </linearGradient>

    <!-- Glass/film overlay: semi-transparent light blue -->
    <linearGradient id="gGlass" x1="10%" y1="0%" x2="70%" y2="100%">
      <stop offset="0%" stop-color="#A8D8FF" stop-opacity="0.85"/>
      <stop offset="40%" stop-color="#6AB8FF" stop-opacity="0.60"/>
      <stop offset="100%" stop-color="#3385FF" stop-opacity="0.10"/>
    </linearGradient>

    <!-- Bright shine on top edge of glass -->
    <linearGradient id="gShine" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="white" stop-opacity="0.45"/>
      <stop offset="100%" stop-color="white" stop-opacity="0.00"/>
    </linearGradient>

    <!-- P inner highlight -->
    <linearGradient id="gPHighlight" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3D8FFF" stop-opacity="0.5"/>
      <stop offset="100%" stop-color="#1448C8" stop-opacity="0.0"/>
    </linearGradient>

    <!-- Drop shadow filter -->
    <filter id="fShadow" x="-15%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#091A50" flood-opacity="0.55"/>
    </filter>

    <!-- Glow filter for P -->
    <filter id="fGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="5" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Soft drop shadow beneath the whole mark -->
  <ellipse cx="95" cy="205" rx="68" ry="8" fill="#0A1F6E" opacity="0.35"/>

  <!-- ── F LETTER (back layer, deep navy) ── -->
  <!-- Vertical stem -->
  <rect x="12" y="12" width="30" height="170" rx="6" fill="url(#gF)" filter="url(#fShadow)"/>
  <!-- Top horizontal bar -->
  <rect x="12" y="12" width="108" height="30" rx="6" fill="url(#gF)"/>
  <!-- Middle horizontal bar -->
  <rect x="12" y="92" width="82" height="26" rx="6" fill="url(#gF)"/>

  <!-- ── P LETTER (front layer, bright royal blue) ── -->
  <!-- Vertical stem (overlapping F) -->
  <rect x="78" y="12" width="30" height="170" rx="6" fill="url(#gP)" filter="url(#fGlow)"/>
  <!-- P bowl (D-shape) -->
  <path d="M 92 12 H 143 Q 180 12 180 70 Q 180 128 143 128 H 92 Z" fill="url(#gP)"/>
  <!-- P inner cutout (negative space) -->
  <path d="M 108 34 H 140 Q 158 34 158 70 Q 158 106 140 106 H 108 Z" fill="#030D20"/>
  <!-- P bowl inner highlight -->
  <path d="M 108 34 H 140 Q 158 34 158 70 Q 158 106 140 106 H 108 Z" fill="url(#gPHighlight)" opacity="0.4"/>

  <!-- ── GLASS / FILM OVERLAY (signature película effect) ── -->
  <!-- Main glass band going diagonally across the FP shape -->
  <path d="M 42 12 L 122 12 L 78 182 L 12 182 Z" fill="url(#gGlass)"/>
  <!-- Bright shine at the top of the glass layer -->
  <path d="M 42 12 L 122 12 L 105 52 L 32 50 Z" fill="url(#gShine)"/>
  <!-- Film peel edge line (glowing) -->
  <line x1="122" y1="12" x2="78" y2="182"
    stroke="rgba(180,228,255,0.75)" stroke-width="1.8" stroke-linecap="round"/>

  <!-- Edge highlight on F top bar -->
  <rect x="12" y="12" width="108" height="6" rx="3" fill="rgba(200,230,255,0.18)"/>
  <!-- Edge highlight on P top -->
  <path d="M 92 12 H 143 Q 162 12 172 28 H 90 Z" fill="rgba(200,230,255,0.15)"/>
</svg>
